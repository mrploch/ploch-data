{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/bin/Release/net10.0/Ploch.Data*.dll"
          ],
          "exclude": [
            "**/*Tests*/**",
            "**/ref/**"
          ]
        }
      ],
      "dest": "api",
      "memberLayout": "separatePages",
      "namespaceLayout": "nested",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "articles/**.md", "articles/**/toc.yml", "toc.yml", "index.md" ] }
    ],
    "resource": [ { "files": [ "images/**" ] } ],
    "overwrite": [
      { "files": [ "namespaces/**.md" ], "exclude": [ "obj/**", "_site/**" ] }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "Ploch.Data",
      "_appTitle": "Ploch.Data — Generic Repository, Unit of Work and EF Core utilities",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/mrploch/ploch-data",
        "branch": "main"
      }
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [ "default", "modern" ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
