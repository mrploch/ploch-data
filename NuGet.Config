<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- Clear inherited sources (including any machine-global feeds) so Central Package
             Management sees a deterministic, fully-mapped source list and does not emit NU1507. -->
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="github" value="https://nuget.pkg.github.com/mrploch/index.json" />
    </packageSources>
    <!-- CPM requires every source to be mapped. Public packages come from nuget.org; the MrPloch
         GitHub Packages feed serves the Ploch.* packages.

         Do not add a machine-local folder feed here: this file is committed and consumed by CI
         and by anyone cloning the repository, and NuGet raises NU1301 (a hard restore error) as
         soon as a mapped source path does not exist on the restoring machine. Developers who
         want a local folder feed should add it to their user-level NuGet.Config instead. -->
    <packageSourceMapping>
        <clear />
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="Ploch.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
