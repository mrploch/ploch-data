<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- Clear inherited sources (including any machine-global feeds) so Central Package
             Management sees a deterministic, fully-mapped source list and does not emit NU1507. -->
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="github" value="https://nuget.pkg.github.com/mrploch/index.json" />
    </packageSources>
    <!-- CPM requires every source to be mapped. Public packages come from nuget.org; the MrPloch
         GitHub Packages feed serves the Ploch.* packages.

         Do not add a machine-local folder feed here: this file is committed and consumed by CI
         and by anyone cloning the repository, and NuGet raises NU1301 (a hard restore error) as
         soon as a mapped source path does not exist on the restoring machine.

         Note that adding one to the user-level NuGet.Config does not work either, because the
         <clear /> above discards inherited package sources. A developer who needs a local folder
         feed should keep a separate, uncommitted configuration file and pass it explicitly to
         "dotnet restore" through its configfile option. (An XML comment cannot contain a double
         hyphen, so the option is named rather than written out here.)

         Credentials are the exception to that rule: packageSourceCredentials are matched by
         source name across configuration files and are not affected by <clear />, so a token for
         the "github" source stored in the user-level configuration still applies here. -->
    <packageSourceMapping>
        <clear />
        <packageSource key="nuget.org">
            <package pattern="*" />
            <!-- Ploch.* must be listed here as well as under "github".

                 Source mapping resolves by the MOST SPECIFIC matching pattern, so with
                 Ploch.* mapped only to the GitHub Packages feed, the "*" entry above never
                 applied to a Ploch package and nuget.org was never consulted for one. Stable
                 releases go to nuget.org and only prereleases go to GitHub Packages, so every
                 published stable Ploch package was invisible to this repository:

                   error NU1103: Unable to find a stable package Ploch.Common with version (>= 4.0.47)
                     - Found 603 version(s) in github [ Nearest version: 4.0.48-pr.328...gc5389e66e6 ]
                     - Versions from nuget.org were not considered

                 Listing the pattern under both sources makes NuGet search both, which is what
                 lets this repository consume a stable Ploch.Common release. -->
            <package pattern="Ploch.*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="Ploch.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
