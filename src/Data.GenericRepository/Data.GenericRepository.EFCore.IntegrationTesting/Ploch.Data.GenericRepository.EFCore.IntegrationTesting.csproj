  <ItemGroup>
    <None Include=".\README.md" Pack="true" PackagePath="\" />

  </ItemGroup>

  <!-- Default (UseProjectReferences=true, every configuration): ProjectReference to the sibling
       ploch-common checkout, for easier debugging and for a consistent Ploch.Common across the
       solution and the unpublished Ploch.TestingSupport.XUnit3.* test dependencies (issue #95). -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\ploch-common\src\Common\Ploch.Common.csproj" />
  </ItemGroup>
  <!-- Opt-in via -p:UseProjectReferences=false: PackageReference (versions from
       Directory.Packages.props). This is how the release workflows pack, so the published nuspecs
       declare the central package versions rather than the sibling checkout's. -->
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Ploch.Common" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Data.EFCore.IntegrationTesting\Ploch.Data.EFCore.IntegrationTesting.csproj" />
    <ProjectReference Include="..\..\Data.EFCore.SqLite\Ploch.Data.EFCore.SqLite.csproj" />
    <ProjectReference Include="..\..\Data.Model\Ploch.Data.Model.csproj" />
    <ProjectReference Include="..\Data.GenericRepository.EFCore\Ploch.Data.GenericRepository.EFCore.csproj" />
    <ProjectReference Include="..\Data.GenericRepository\Ploch.Data.GenericRepository.csproj" />
  </ItemGroup>
</Project>
