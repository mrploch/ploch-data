<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generic repository for Entity Framework Core</Description>
    <PackageTags>efcore;dotnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <!-- Default (UseProjectReferences=true, every configuration): ProjectReference to the sibling
       ploch-common checkout, for easier debugging and for a consistent Ploch.Common across the
       solution and the unpublished Ploch.TestingSupport.XUnit3.* test dependencies (issue #95). -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\ploch-common\src\Common.AppServices\Ploch.Common.AppServices.csproj" />
    <ProjectReference Include="..\..\..\..\ploch-common\src\Common.DependencyInjection\Ploch.Common.DependencyInjection.csproj" />
  </ItemGroup>
  <!-- Opt-in via -p:UseProjectReferences=false: PackageReference (versions from
       Directory.Packages.props). This is how the release workflows pack, so the published nuspecs
       declare the central package versions rather than the sibling checkout's. -->
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Ploch.Common.AppServices" />
    <PackageReference Include="Ploch.Common.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data.EFCore\Ploch.Data.EFCore.csproj" />
    <ProjectReference Include="..\Data.GenericRepository\Ploch.Data.GenericRepository.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".\README.md" Pack="true" PackagePath="\" />

  </ItemGroup>

</Project>
